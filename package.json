{
  "name": "alpiplan",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Alpiplan (ogama) — multi-tenant scheduling platform",
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:baseline": "bash scripts/baseline-migrations.sh",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev:web": "pnpm --filter @alpiplan/web dev",
    "dev:worker": "pnpm --filter @alpiplan/worker dev",
    "dev:mobile": "pnpm --filter @alpiplan/mobile-shell cap:open:android",
    "deploy:main": "node scripts/deploy.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "deploy:fast": "node scripts/deploy-fast.mjs",
    "import:flights": "tsx scripts/import-flights.ts",
    "import:mongo": "tsx scripts/import_from_mongo.ts",
    "test-skischule:seed": "tsx scripts/seed-test-skischule.ts",
    "test-skischule:delete": "tsx scripts/delete-test-skischule.ts"
  },
  "dependencies": {
    "@prisma/client": "6.9.0"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.2",
    "fs": "0.0.1-security",
    "mongo": "^0.1.0",
    "mongodb": "^7.1.1",
    "prisma": "6.9.0",
    "tsx": "^4.19.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "vue": "3.5.32",
      "@vue/runtime-core": "3.5.32",
      "@vue/runtime-dom": "3.5.32",
      "@vue/server-renderer": "3.5.32",
      "@vue/shared": "3.5.32"
    }
  }
}
