# Lokale PostgreSQL — Datenbank anlegen z. B. mit:
#   psql -U postgres -h localhost -c "CREATE DATABASE alpiplan;"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alpiplan?schema=public"

# Nitro / Auth — JWT (min. 16 Zeichen in Production)
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: Token-Laufzeiten (jose-kompatible Strings)
# Access-Cookie ist kurz; Refresh-Cookie hält die App-Session (Standard 400d).
# JWT_ACCESS_TTL=8h
# JWT_REFRESH_TTL=400d

# Optional: HttpOnly-Cookie-Name für die Web-Session
# AUTH_COOKIE_NAME=alpiplan_at

# Capacitor-Hülle (apps/mobile-shell). Wird bei `pnpm cap:sync` aus dieser Datei gelesen.
# Live / App-Test:   https://app.alpiplan.com
# Android-Emulator:  http://10.0.2.2:3000
# Physisches Gerät:  http://192.168.x.x:3000  (LAN-IP des Rechners, Nuxt mit --host 0.0.0.0)
CAPACITOR_SERVER_URL=https://app.alpiplan.com

# Push (FCM) — damit Termine auch bei geschlossener App ankommen.
# 1. google-services.json nach apps/mobile-shell/ legen, dann `pnpm cap:sync` und APK neu bauen.
# 2. Dienstkonto-JSON (Firebase → Projekteinstellungen → Dienstkonten → Schlüssel generieren)
#    als Datei legen und hier den Pfad setzen — NICHT nur client_email.
# FIREBASE_SERVICE_ACCOUNT_FILE=tmp/firebase-adminsdk.json
# Alternativ die drei Felder aus derselben JSON:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Web Push (Browser + iPhone-Home-Bildschirm-App, ohne Firebase/Apple-Account).
# Einmal erzeugen: cd apps/web && npx web-push generate-vapid-keys
# Keys danach nicht mehr ändern — sonst müssen alle Geräte Push neu einschalten.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@alpiplan.com

# E-Mail-Versand (Passwort vergessen, Einladungen). Ohne SMTP_HOST werden Mails nur ins Server-Log geschrieben.
# APP_URL ist die öffentliche Basis-URL für Links in Mails (in Production Pflicht).
# APP_URL=https://app.alpiplan.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true bei Port 465 (Standard: automatisch nach Port)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Alpiplan <no-reply@alpiplan.com>"
# MAIL_REPLY_TO=support@alpiplan.com

# Anbietername auf der Support-Seite; die Datenschutzerklärung liegt auf der Webseite
# NUXT_PUBLIC_LEGAL_NAME="Firma GmbH"
# NUXT_PUBLIC_WEBSITE_URL=https://alpiplan.com
# NUXT_PUBLIC_SUPPORT_EMAIL=support@alpiplan.com

# Native App-Updates: Den Hinweis „Update verfügbar“ holt die App selbst aus Play Store / App Store.
# MIN nur setzen, wenn ältere Versionen gesperrt werden sollen (Dialog ohne „Später“);
# Wert = versionCode aus apps/mobile-shell/capacitor.config.ts, erst wenn sie im Store live ist. 0/leer = aus.
# NUXT_APP_UPDATE_ANDROID_MIN_VERSION_CODE=9
# NUXT_APP_UPDATE_IOS_MIN_VERSION_CODE=9
# Einmalig setzen, damit iOS den Store-Eintrag zuverlässig findet:
# NUXT_APP_UPDATE_IOS_APP_STORE_ID=123456789   # Zahl aus https://apps.apple.com/app/id…
# NUXT_APP_UPDATE_IOS_COUNTRY=it               # Store-Land für die Versionsabfrage

# prisma/seed.ts — Demo-Tenant + Nutzer
# SEED_DEMO_EMAIL=demo@alpiplan.local
# SEED_DEMO_PASSWORD=demo123
# SEED_DEMO_NAME="Demo Admin"
# SEED_TENANT_NAME="Demo Studio"
# SEED_TENANT_SLUG=demo-studio
# SEED_DEMO_IS_SUPERADMIN=true

# KI-Textauswertung in der Schnellerfassung. Der Superadmin schaltet sie pro Mandant frei (Mandanten-Seite).
# Ohne Key bleibt der eingebaute Regel-Parser aktiv. Kundenlisten werden nicht an das Modell gesendet.
# Anbieter: automatisch nach vorhandenem Key (Anthropic vor Gemini) oder explizit anthropic|gemini.
# ASSISTANT_AI_PROVIDER=gemini
# ANTHROPIC_API_KEY=
# ANTHROPIC_INTENT_MODEL=claude-haiku-5-5   (Standard; Alternative claude-opus-5-5)
# GEMINI_API_KEY=
# GEMINI_INTENT_MODEL=gemini-flash-lite-latest   (Standard: Google-Alias, schnell und günstig; Alternativen gemini-flash-latest oder fest z. B. gemini-3.8-flash)
# AI_INTENT_TIMEOUT_MS=20000                 (Zeitlimit je Modellaufruf, danach antwortet der Regel-Parser)
